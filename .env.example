# Telegram — real outbound (Phase 15.1). Omit token or set TELEGRAM_SANDBOX=1 for synthetic sender.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# TELEGRAM_SANDBOX=true

# Optional HTTP(S) proxy for Bot API (Phase 15.2). Userinfo can be set via URL or USERNAME/PASSWORD.
# TELEGRAM_PROXY_URL=http://proxy.example.com:8080
# TELEGRAM_PROXY_USERNAME=
# TELEGRAM_PROXY_PASSWORD=

# Meta (WhatsApp + Messenger) webhook signature verification (Phase 15.4a)
# Set at least one of these to enable POST signature validation
# META_APP_SECRET=                # Shared secret for both WhatsApp and Messenger
# WHATSAPP_APP_SECRET=           # WhatsApp-specific secret (overrides META_APP_SECRET)
# MESSENGER_APP_SECRET=          # Messenger-specific secret (overrides META_APP_SECRET)
# Leave all empty to disable signature verification (compatibility with existing dev setups)

# Phase 17.2 — Meta Graph fb_exchange_token (optional; same switch as Zalo: CHATFLOW_INPROCESS_TOKEN_REFRESH=1)
# META_APP_ID=                  # Facebook App ID (required for in-process token exchange)
# Uses META_APP_SECRET or WHATSAPP_APP_SECRET or MESSENGER_APP_SECRET as client_secret (see docs/156)

# Line webhook signature verification (Phase 15.4b)
# LINE_CHANNEL_SECRET=           # Line channel secret for X-Line-Signature validation
# Leave empty to disable signature verification (compatibility with existing dev setups)

# Website webhook signature verification (Phase 15.4d)
# WEBSITE_WEBHOOK_SIGNING_SECRET= # Signing secret for X-Webhook-Signature (sha256=<hex> format)
# Leave empty to disable signature verification (compatibility with existing dev setups)

# WhatsApp Cloud API real outbound (Phase 15.5 — implemented)
# WHATSAPP_ACCESS_TOKEN=        # WhatsApp Cloud API access token (never log)
# WHATSAPP_PHONE_NUMBER_ID=     # Business phone number ID from Meta
# WHATSAPP_API_VERSION=v19.0    # Optional Graph API version (default: v19.0)
# WHATSAPP_SANDBOX=true         # Optional: set to true/1 to force synthetic sender
# WHATSAPP_CLOUD_DISABLED=true  # Optional: alternative disable flag

# Messenger Graph API real outbound (Phase 15.6 — implemented)
# MESSENGER_PAGE_ACCESS_TOKEN=  # Facebook Page access token (never log)
# MESSENGER_PAGE_ID=            # Facebook Page ID (numeric)
# MESSENGER_API_VERSION=v19.0   # Optional Graph API version (default: v19.0)
# MESSENGER_SANDBOX=true        # Optional: set to true/1 to force synthetic sender
# MESSENGER_GRAPH_DISABLED=true # Optional: alternative disable flag

# Line Messaging API real outbound (Phase 15.7 — implemented)
# LINE_CHANNEL_ACCESS_TOKEN=    # Line Messaging API channel access token (never log)
# LINE_API_BASE_URL=https://api.line.me # Optional override for testing
# LINE_SANDBOX=true             # Optional: set to true/1 to force synthetic sender
# LINE_CHANNEL_SECRET=          # Already used for inbound signature (Phase 15.4b)

# Zalo Open API real outbound (Phase 15.x)
# ZALO_ACCESS_TOKEN=           # Zalo Open API access token (OAuth 2.0, never log)
# ZALO_OA_ID=                  # Zalo Official Account ID (numeric)
# ZALO_API_BASE_URL=https://openapi.zalo.me # Optional override for testing
# ZALO_SANDBOX=true            # Optional: set to true/1 to force synthetic sender
# ZALO_MESSAGING_DISABLED=true # Optional: alternative disable flag

# Phase 17 — optional in-process Zalo OA refresh on 401 (docs/154). Requires OAuth app credentials + refresh token.
# CHATFLOW_INPROCESS_TOKEN_REFRESH=1
# ZALO_REFRESH_TOKEN=          # OA refresh token (never log)
# ZALO_APP_ID=                   # Zalo app id (OAuth)
# ZALO_APP_SECRET=               # Zalo app secret (never log; sent as secret_key header to token endpoint)

# Webhook GET verification (Phase 15.3). Meta-style: hub.mode=subscribe&hub.verify_token=...&hub.challenge=...
# Never commit real tokens. Do not log these values.
# META_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# MESSENGER_WEBHOOK_VERIFY_TOKEN=
# WEBSITE_WEBHOOK_VERIFY_TOKEN=
# LINE_WEBHOOK_VERIFY_TOKEN=
# ZALO_WEBHOOK_VERIFY_TOKEN=

# HTTP observability (Phase 16). When true/1/json: one JSON line per response on res "finish" (duration_ms, channel for /webhooks/*).
# Response header X-Request-Id is always set (no secrets). Recommended on VPS/staging; comment out locally if too noisy.
CHATFLOW_HTTP_ACCESS_LOG=true

# Phase D-C1 — structured runtime / ops alert / platform audit (opt-in JSON lines; no external APM required).
# CHATFLOW_STRUCTURED_RUNTIME_LOG=1
# CHATFLOW_OPS_ALERT_LOG=1
# CHATFLOW_PLATFORM_AUDIT_LOG=1

# Optional: POST JSON when a lead is first persisted (same shape as one line in data/local-captured-leads.jsonl). Fire-and-forget; failures log only. Receiver contract → docs/161_phase17_notify_webhooks.md
# CHATFLOW_LEAD_NOTIFY_URL=https://hooks.example.com/incoming
# Optional shared secret — receiver should verify header X-Chatflow-Lead-Notify-Secret (never log).
# CHATFLOW_LEAD_NOTIFY_SECRET=

# Ops: rotating Meta/Zalo/Line/Telegram outbound tokens — platform secret + restart; see docs/152_phase16_ops_token_rotation_runbook.md

# Website outbound push (Phase 17.0 — real transport)
# WEBSITE_OUTBOUND_URL=                    # Customer HTTPS callback endpoint (required for real send)
# WEBSITE_OUTBOUND_SIGNING_SECRET=         # Optional: shared secret for X-Webhook-Signature header
# WEBSITE_OUTBOUND_DISABLED=1              # Optional: force synthetic sender
# WEBSITE_OUTBOUND_SANDBOX=1               # Optional: skip real send (development)
# WEBSITE_OUTBOUND_TIMEOUT_MS=10000        # Optional: timeout in milliseconds (default: 10000)

# Handoff trigger keywords (optional)
# Comma-separated list of keywords that trigger handoff to human agent
# Default: 人工,转人工,agent,human,客服,customer service,operator,support,help desk
# CHATFLOW_HANDOFF_KEYWORDS=

# Optional: POST JSON when session first enters handoff pending (event handoff_pending). Fire-and-forget; failures log only. Receiver contract → docs/161_phase17_notify_webhooks.md
# CHATFLOW_HANDOFF_NOTIFY_URL=https://hooks.example.com/handoff
# Optional shared secret — receiver should verify header X-Chatflow-Handoff-Notify-Secret (never log).
# CHATFLOW_HANDOFF_NOTIFY_SECRET=

# Handoff reply suppression (optional)
# When set to 1/true/yes, bot will not send reply when handoff is required
# Default: unset (bot still sends reply even during handoff)
# When 1/true/yes: skip bot outbound while handoff_required (see docs/161 section 3).
# CHATFLOW_SUPPRESS_REPLY_ON_HANDOFF=

# Handoff auto-assignment (optional)
# When set, automatically assigns this owner ID when handoff is triggered
# Format: any string identifier (e.g., "agent-1", "support-team")
# CHATFLOW_HANDOFF_AUTO_ASSIGN_OWNER=

# Handoff assignment strategy (optional)
# Mode: single (use AUTO_ASSIGN_OWNER), round_robin (use OWNER_POOL), by_tag (use TAG_MAP)
# Default: single
# CHATFLOW_HANDOFF_ASSIGN_MODE=single

# Handoff owner pool for round_robin mode (optional)
# Comma-separated list of owner IDs (e.g., "agent-1,agent-2,agent-3")
# CHATFLOW_HANDOFF_OWNER_POOL=

# Handoff tag mapping for by_tag mode (optional)
# Format: "tag1:owner1,tag2:owner2" (e.g., "high_intent:sales,complete_profile:senior")
# CHATFLOW_HANDOFF_TAG_MAP=

# Agent status management (optional)
# Format: "agent1:on,agent2:off,agent3:on"
# CHATFLOW_HANDOFF_AGENT_STATUS=

# Sticky assignment TTL (optional)
# Minutes to consider previous assignment as "sticky" for same session
# Default: 120 minutes
# CHATFLOW_HANDOFF_ASSIGN_STICKY_TTL_MIN=120

# Load balancing strategy (optional)
# Options: least_recent (default), round_robin
# CHATFLOW_HANDOFF_ASSIGN_BALANCE=least_recent

# Operations alerts webhook (optional)
# URL to POST daily handoff performance alerts
# CHATFLOW_OPS_ALERT_WEBHOOK_URL=https://your-webhook.example.com/alerts

# Operations alert secret (optional)
# Shared secret for alert webhook authentication (sent as x-chatflow-ops-alert-secret header)
# CHATFLOW_OPS_ALERT_SECRET=your-alert-secret-here

# Minimum alert interval (optional)
# Seconds between sending alerts with same flags (prevents spam)
# Default: 300 seconds (5 minutes)
# CHATFLOW_OPS_ALERT_MIN_INTERVAL_SEC=300

# Autotune configuration (optional)
# Enable automatic parameter tuning based on performance
# CHATFLOW_OPS_AUTOTUNE=0

# Autotune write runtime config (optional, Phase 21.2)
# When 1 and CHATFLOW_HANDOFF_RUNTIME_CONFIG_PATH is set, autotune will write
# approved changes to the runtime JSON file (Unix: send SIGHUP or restart to apply)
# CHATFLOW_OPS_AUTOTUNE_WRITE_RUNTIME=0

# Autotune state file path (optional)
# CHATFLOW_OPS_AUTOTUNE_STATE_PATH=data/.handoff-autotune-state.json

# Autotune cooldown period (optional)
# Minutes between autotune runs (prevents excessive changes)
# Default: 1440 minutes (24 hours)
# CHATFLOW_OPS_AUTOTUNE_COOLDOWN_MIN=1440

# Autotune rules mode (optional)
# Options: conservative (default), aggressive
# CHATFLOW_OPS_AUTOTUNE_RULES=conservative

# Phase 21 — Handoff runtime config reload (optional)
# Path to JSON file that can override handoff assignment parameters via SIGHUP
# Priority: env is base; JSON only overrides keys that appear in the file
# Example JSON content (save as data/handoff-assign-runtime.json):
# {
#   "assign_mode": "round_robin",
#   "owner_pool": ["agent-1", "agent-2"],
#   "agent_status": {"agent-1": "on", "agent-2": "off"},
#   "assign_balance": "least_recent",
#   "assign_sticky_ttl_min": 60
# }
# Whitelisted keys: assign_mode, auto_assign_owner, owner_pool, tag_map, agent_status, assign_balance, assign_sticky_ttl_min
# CHATFLOW_HANDOFF_RUNTIME_CONFIG_PATH=data/handoff-assign-runtime.json

# --- Multi-tenant SaaS (MVP) ---
# Admin API + dashboard: set a strong random token. Dashboard: GET /saas/admin
# CHATFLOW_SAAS_ADMIN_TOKEN=
# Phase 24 / 1E — dev/ops bridge only (JSON slug→secret, NOT a production login). Break-glass token checked first.
# CHATFLOW_SAAS_TENANT_ADMIN_TOKENS={"acme-corp":"random-secret-per-tenant"}
# Phase 24 / 1F — read-only bridge (same JSON shape). Priority: break-glass > admin map > readonly map.
# CHATFLOW_SAAS_TENANT_READONLY_TOKENS={"acme-corp":"readonly-secret"}
# Optional SQLite file path (default: data/chatflow-saas.sqlite under process cwd)
# CHATFLOW_SAAS_DB_PATH=
# Phase D-C2A — 32-byte AES master key for tenant_credentials at-rest (64 hex chars or base64 of 32 bytes). Unset = plaintext store (dev only).
# CHATFLOW_SAAS_CREDENTIALS_MASTER_KEY=
# Tenant webhook URLs: https://<host>/webhooks/t/<tenant-slug>/<channel>
# Per-tenant secrets and FAQ are stored in the SaaS DB (not in this file).
