{
  "name": "chatflow-pro",
  "version": "1.7.44",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "smoke:webhooks": "node scripts/smoke-webhooks.mjs",
    "verify:lead-capture-states": "node scripts/verify-lead-capture-states.mjs",
    "dev:website-outbound-echo": "node scripts/website-outbound-echo.mjs",
    "dev:notify-echo": "node scripts/notify-echo-server.mjs",
    "check:agent-env": "node scripts/agent-env-check.mjs",
    "check:staging-env": "node scripts/check-staging-env.mjs",
    "check:staging-env:debug": "node scripts/check-staging-env.mjs --debug-parse",
    "report:agent-git": "node scripts/agent-git-metadata.mjs",
    "report:github-ci": "node scripts/report-github-ci.mjs",
    "verify:local": "npm run build && npm run report:agent-git",
    "staging:docker-smoke": "node scripts/staging-docker-smoke.mjs",
    "staging:docker-smoke:t2": "node scripts/run-staging-t2.mjs",
    "docs:pdf:160": "node scripts/build-doc160-pdf.mjs",
    "docker:up:local-env": "docker compose -f docker-compose.yml -f docker-compose.local-credentials.yml up --build"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "undici": "^6.24.1"
  }
}
