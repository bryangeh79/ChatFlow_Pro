{
  "name": "chatflow-pro",
  "version": "1.7.21",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "smoke:webhooks": "node scripts/smoke-webhooks.mjs",
